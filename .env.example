JWT_SECRET=change-me-in-production
ECO_SECRET_KEY=change-me-in-production

# Nginx gateway: сначала init.conf, после ./gateway/init-ssl.sh → nginx.conf
GATEWAY_NGINX_CONF=./gateway/nginx.init.conf

# Email для Let's Encrypt (Certbot)
CERTBOT_EMAIL=you@mail.ru

