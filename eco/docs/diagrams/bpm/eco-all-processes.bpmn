    <ns0:startEvent id="Start_1" name="Обращение к модулю"/>
    <ns0:userTask id="U_Login" name="Войти в систему
(email и пароль)"/>
    <ns0:serviceTask id="S_CheckForm" name="Проверить
корректность формы"/>
    <ns0:exclusiveGateway id="G_FormOk" name=""/>
    <ns0:endEvent id="End_Denied" name="Отказ в доступе"/>
    <ns0:serviceTask id="A_Auth" name="Аутентифицировать
пользователя"/>
    <ns0:exclusiveGateway id="G_AuthOk" name=""/>
    <ns0:serviceTask id="S_Session" name="Определить роль
и открыть сессию"/>
    <ns0:exclusiveGateway id="G_Role" name="Роль?"/>
    <ns0:userTask id="U_OrgList" name="Просмотреть реестр
организаций"/>
    <ns0:serviceTask id="A_LoadOrg" name="Загрузить организации,
партии и измерения"/>
    <ns0:serviceTask id="S_OrgQuality" name="Оценить качество
и целостность данных"/>
    <ns0:userTask id="U_OrgCard" name="Просмотреть карточку
организации"/>
    <ns0:userTask id="U_DataControl" name="Выполнить контроль
качества данных"/>
    <ns0:userTask id="U_Batches" name="Просмотреть партии
отходов"/>
    <ns0:exclusiveGateway id="G_Superuser" name="Супер-
пользователь?"/>
    <ns0:userTask id="U_Register" name="Зарегистрировать
нового пользователя"/>
    <ns0:serviceTask id="A_Register" name="Создать учётную
запись"/>
    <ns0:userTask id="U_WasteTypes" name="Просмотреть справочник
типов отходов (ФККО)"/>
    <ns0:exclusiveGateway id="G_RemoteApi" name="Удалённое
API?"/>
    <ns0:serviceTask id="S_BlockWaste" name="Запретить изменение
справочника"/>
    <ns0:endEvent id="End_Admin" name="Завершение работы
администратора"/>
    <ns0:userTask id="U_Movements" name="Просмотреть журнал
операций с отходами"/>
    <ns0:serviceTask id="A_LoadOps" name="Загрузить журнал
операций"/>
    <ns0:userTask id="U_Export" name="Выгрузить журнал
(xlsx / pdf / xml)"/>
    <ns0:userTask id="U_MeasList" name="Просмотреть
экологические измерения"/>
    <ns0:userTask id="U_MeasNew" name="Зафиксировать
новое измерение"/>
    <ns0:serviceTask id="S_MeasValidate" name="Проверить данные
и связь с партией"/>
    <ns0:exclusiveGateway id="G_MeasOk" name=""/>
    <ns0:serviceTask id="A_SaveMeas" name="Сохранить
измерение"/>
    <ns0:serviceTask id="S_BlockMeasEdit" name="Запретить изменение
и удаление измерений"/>
    <ns0:endEvent id="End_Ecologist" name="Завершение работы
эколога"/>
    <ns0:userTask id="U_KPI" name="Просмотреть дашборд KPI"/>
    <ns0:serviceTask id="S_Aggregate" name="Сформировать
показатели и графики"/>
    <ns0:userTask id="U_Report" name="Просмотреть
отчётный дашборд"/>
    <ns0:serviceTask id="A_Dashboard" name="Получить сводку
отчётности"/>
    <ns0:endEvent id="End_Manager" name="Завершение
просмотра отчётов"/>
    <ns0:userTask id="U_Logout" name="Выйти из системы"/>
    <ns0:endEvent id="End_Logout" name="Сессия завершена"/>
    <ns0:sequenceFlow id="f01" sourceRef="Start_1" targetRef="U_Login"/>
