<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P01_Auth" targetNamespace="http://bpmn.io/schema/bpmn" exporter="eco-diplom" exporterVersion="3.0">
  <bpmn:process id="Process_P01_Auth" name="P-01. Аутентификация через API" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="lane_user" name="Пользователь">
        <bpmn:flowNodeRef>n_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_err</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end_fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_eco" name="Веб-модуль ECO">
        <bpmn:flowNodeRef>n_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_session</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_redirect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_api" name="API платформы">
        <bpmn:flowNodeRef>n_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_profile</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start" name="Начало">

      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_login" name="Ввод email и пароля">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="n_req" name="Передача запроса на вход">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_verify" name="Проверка учётных данных и выдача токена">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_gw" name="Учётные данные верны?">
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f_yes</bpmn:outgoing>
      <bpmn:outgoing>f_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_profile" name="Получение профиля пользователя">
      <bpmn:incoming>f_yes</bpmn:incoming>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_sync" name="Синхронизация пользователя и роли">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_session" name="Сохранение токена в сессии">
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_redirect" name="Перенаправление на домашнюю страницу">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="n_end_ok" name="Конец (вход выполнен)">
      <bpmn:incoming>f08</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:userTask id="n_err" name="Отображение сообщения об ошибке">
      <bpmn:incoming>f_no</bpmn:incoming>
      <bpmn:outgoing>f_err</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="n_end_fail" name="Конец (ошибка входа)">
      <bpmn:incoming>f_err</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f01" sourceRef="n_start" targetRef="n_login">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f02" sourceRef="n_login" targetRef="n_req">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f03" sourceRef="n_req" targetRef="n_verify">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f04" sourceRef="n_verify" targetRef="n_gw">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_yes" sourceRef="n_gw" targetRef="n_profile" name="да">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no" sourceRef="n_gw" targetRef="n_err" name="нет">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f05" sourceRef="n_profile" targetRef="n_sync">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f06" sourceRef="n_sync" targetRef="n_session">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f07" sourceRef="n_session" targetRef="n_redirect">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f08" sourceRef="n_redirect" targetRef="n_end_ok">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_err" sourceRef="n_err" targetRef="n_end_fail">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P01_Auth">
    <bpmndi:BPMNPlane id="Plane_P01_Auth" bpmnElement="Process_P01_Auth">
      <bpmndi:BPMNShape id="lane_user_di" bpmnElement="lane_user" isHorizontal="true">
        <dc:Bounds x="80" y="52" width="1838" height="142" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_eco_di" bpmnElement="lane_eco" isHorizontal="true">
        <dc:Bounds x="80" y="194" width="1838" height="142" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_api_di" bpmnElement="lane_api" isHorizontal="true">
        <dc:Bounds x="80" y="336" width="1838" height="142" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_di" bpmnElement="n_start">
        <dc:Bounds x="140" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_login_di" bpmnElement="n_login">
        <dc:Bounds x="292" y="76" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_req_di" bpmnElement="n_req">
        <dc:Bounds x="444" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_verify_di" bpmnElement="n_verify">
        <dc:Bounds x="596" y="356" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_gw_di" bpmnElement="n_gw" isMarkerVisible="true">
        <dc:Bounds x="784" y="225" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_profile_di" bpmnElement="n_profile">
        <dc:Bounds x="900" y="356" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_sync_di" bpmnElement="n_sync">
        <dc:Bounds x="1052" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_session_di" bpmnElement="n_session">
        <dc:Bounds x="1204" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_redirect_di" bpmnElement="n_redirect">
        <dc:Bounds x="1356" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_ok_di" bpmnElement="n_end_ok">
        <dc:Bounds x="1508" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_err_di" bpmnElement="n_err">
        <dc:Bounds x="900" y="76" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_fail_di" bpmnElement="n_end_fail">
        <dc:Bounds x="1052" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f01_di" bpmnElement="f01">
        <di:waypoint x="176" y="108" />
        <di:waypoint x="292" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f02_di" bpmnElement="f02">
        <di:waypoint x="351" y="140" />
        <di:waypoint x="351" y="178" />
        <di:waypoint x="503" y="178" />
        <di:waypoint x="503" y="216" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f03_di" bpmnElement="f03">
        <di:waypoint x="503" y="280" />
        <di:waypoint x="503" y="318" />
        <di:waypoint x="655" y="318" />
        <di:waypoint x="655" y="356" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f04_di" bpmnElement="f04">
        <di:waypoint x="714" y="388" />
        <di:waypoint x="749" y="388" />
        <di:waypoint x="749" y="248" />
        <di:waypoint x="784" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_yes_di" bpmnElement="f_yes">
        <di:waypoint x="807" y="271" />
        <di:waypoint x="807" y="313" />
        <di:waypoint x="959" y="313" />
        <di:waypoint x="959" y="356" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_no_di" bpmnElement="f_no">
        <di:waypoint x="830" y="248" />
        <di:waypoint x="865" y="248" />
        <di:waypoint x="865" y="108" />
        <di:waypoint x="900" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f05_di" bpmnElement="f05">
        <di:waypoint x="1018" y="388" />
        <di:waypoint x="1042" y="388" />
        <di:waypoint x="1042" y="248" />
        <di:waypoint x="1052" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f06_di" bpmnElement="f06">
        <di:waypoint x="1170" y="248" />
        <di:waypoint x="1204" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f07_di" bpmnElement="f07">
        <di:waypoint x="1322" y="248" />
        <di:waypoint x="1356" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f08_di" bpmnElement="f08">
        <di:waypoint x="1474" y="248" />
        <di:waypoint x="1498" y="248" />
        <di:waypoint x="1498" y="108" />
        <di:waypoint x="1508" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_err_di" bpmnElement="f_err">
        <di:waypoint x="1018" y="108" />
        <di:waypoint x="1052" y="108" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
