<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DC" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_P08_DataControl" targetNamespace="http://bpmn.io/schema/bpmn" exporter="eco-diplom" exporterVersion="3.0">
  <bpmn:process id="Process_P08_DataControl" name="P-08. Контроль качества данных" isExecutable="false">
    <bpmn:laneSet>
      <bpmn:lane id="lane_user" name="Пользователь">
        <bpmn:flowNodeRef>n_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_show_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_eco" name="Веб-модуль ECO">
        <bpmn:flowNodeRef>n_fetch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_org_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_batch_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n_show_problem</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_api" name="API платформы">
        <bpmn:flowNodeRef>n_data</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="n_start" name="Начало">

      <bpmn:outgoing>f01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="n_open" name="Открыть раздел «Контроль данных»">
      <bpmn:incoming>f01</bpmn:incoming>
      <bpmn:outgoing>f02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="n_fetch" name="Запрос данных с платформы">
      <bpmn:incoming>f02</bpmn:incoming>
      <bpmn:outgoing>f03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_data" name="Формирование наборов организаций и партий">
      <bpmn:incoming>f03</bpmn:incoming>
      <bpmn:outgoing>f04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_org_check" name="Проверка полноты данных организаций">
      <bpmn:incoming>f04</bpmn:incoming>
      <bpmn:outgoing>f05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_batch_check" name="Проверка согласованности по партиям">
      <bpmn:incoming>f05</bpmn:incoming>
      <bpmn:outgoing>f06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="n_calc" name="Расчёт уровня проблемности (severity)">
      <bpmn:incoming>f06</bpmn:incoming>
      <bpmn:outgoing>f07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="n_gw" name="Обнаружены критические проблемы?">
      <bpmn:incoming>f07</bpmn:incoming>
      <bpmn:outgoing>f_yes</bpmn:outgoing>
      <bpmn:outgoing>f_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="n_show_problem" name="Отображение списка проблемных организаций">
      <bpmn:incoming>f_yes</bpmn:incoming>
      <bpmn:outgoing>f08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="n_show_ok" name="Отображение сводки без критических проблем">
      <bpmn:incoming>f_no</bpmn:incoming>
      <bpmn:outgoing>f09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="n_end" name="Конец">
      <bpmn:incoming>f08</bpmn:incoming>
      <bpmn:incoming>f09</bpmn:incoming>

    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f01" sourceRef="n_start" targetRef="n_open">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f02" sourceRef="n_open" targetRef="n_fetch">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f03" sourceRef="n_fetch" targetRef="n_data">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f04" sourceRef="n_data" targetRef="n_org_check">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f05" sourceRef="n_org_check" targetRef="n_batch_check">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f06" sourceRef="n_batch_check" targetRef="n_calc">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f07" sourceRef="n_calc" targetRef="n_gw">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_yes" sourceRef="n_gw" targetRef="n_show_problem" name="да">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_no" sourceRef="n_gw" targetRef="n_show_ok" name="нет">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f08" sourceRef="n_show_problem" targetRef="n_end">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f09" sourceRef="n_show_ok" targetRef="n_end">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P08_DataControl">
    <bpmndi:BPMNPlane id="Plane_P08_DataControl" bpmnElement="Process_P08_DataControl">
      <bpmndi:BPMNShape id="lane_user_di" bpmnElement="lane_user" isHorizontal="true">
        <dc:Bounds x="80" y="52" width="1990" height="142" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_eco_di" bpmnElement="lane_eco" isHorizontal="true">
        <dc:Bounds x="80" y="194" width="1990" height="142" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_api_di" bpmnElement="lane_api" isHorizontal="true">
        <dc:Bounds x="80" y="336" width="1990" height="142" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_start_di" bpmnElement="n_start">
        <dc:Bounds x="140" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_open_di" bpmnElement="n_open">
        <dc:Bounds x="292" y="76" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_fetch_di" bpmnElement="n_fetch">
        <dc:Bounds x="444" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_data_di" bpmnElement="n_data">
        <dc:Bounds x="596" y="356" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_org_check_di" bpmnElement="n_org_check">
        <dc:Bounds x="748" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_batch_check_di" bpmnElement="n_batch_check">
        <dc:Bounds x="900" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_calc_di" bpmnElement="n_calc">
        <dc:Bounds x="1052" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_gw_di" bpmnElement="n_gw" isMarkerVisible="true">
        <dc:Bounds x="1240" y="225" width="46" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_show_problem_di" bpmnElement="n_show_problem">
        <dc:Bounds x="1356" y="216" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_show_ok_di" bpmnElement="n_show_ok">
        <dc:Bounds x="1356" y="76" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="n_end_di" bpmnElement="n_end">
        <dc:Bounds x="1660" y="90" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f01_di" bpmnElement="f01">
        <di:waypoint x="176" y="108" />
        <di:waypoint x="292" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f02_di" bpmnElement="f02">
        <di:waypoint x="351" y="140" />
        <di:waypoint x="351" y="178" />
        <di:waypoint x="503" y="178" />
        <di:waypoint x="503" y="216" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f03_di" bpmnElement="f03">
        <di:waypoint x="503" y="280" />
        <di:waypoint x="503" y="318" />
        <di:waypoint x="655" y="318" />
        <di:waypoint x="655" y="356" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f04_di" bpmnElement="f04">
        <di:waypoint x="714" y="388" />
        <di:waypoint x="738" y="388" />
        <di:waypoint x="738" y="248" />
        <di:waypoint x="748" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f05_di" bpmnElement="f05">
        <di:waypoint x="866" y="248" />
        <di:waypoint x="900" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f06_di" bpmnElement="f06">
        <di:waypoint x="1018" y="248" />
        <di:waypoint x="1052" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f07_di" bpmnElement="f07">
        <di:waypoint x="1170" y="248" />
        <di:waypoint x="1240" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_yes_di" bpmnElement="f_yes">
        <di:waypoint x="1286" y="248" />
        <di:waypoint x="1356" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_no_di" bpmnElement="f_no">
        <di:waypoint x="1286" y="248" />
        <di:waypoint x="1321" y="248" />
        <di:waypoint x="1321" y="108" />
        <di:waypoint x="1356" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f08_di" bpmnElement="f08">
        <di:waypoint x="1474" y="248" />
        <di:waypoint x="1567" y="248" />
        <di:waypoint x="1567" y="108" />
        <di:waypoint x="1660" y="108" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f09_di" bpmnElement="f09">
        <di:waypoint x="1474" y="108" />
        <di:waypoint x="1660" y="108" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
